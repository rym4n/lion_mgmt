{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.aioe.local/aioe.network-topology.api/view-response/v1",
  "type": "object", "additionalProperties": false, "required": ["code", "data"],
  "properties": {
    "code": {"const": 0},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["current_scope", "breadcrumbs", "nodes", "edges", "scope_layout_revision", "layout_set_revision", "graph_revision", "total_direct_items", "overflow_strategy", "view_buckets", "continuation_token"],
      "properties": {
        "view_type": {"enum": ["physical", "logical"]},
        "warnings": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["code", "message"],
            "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
          }
        },
        "evidence_summary": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "device_count": {"type": "integer", "minimum": 0},
            "physical_link_count": {"type": "integer", "minimum": 0},
            "observed_boundary_count": {"type": "integer", "minimum": 0},
            "devices_without_physical_neighbors": {"type": "integer", "minimum": 0},
            "devices_without_location": {"type": "integer", "minimum": 0}
          }
        },
        "current_scope": {"type": "object", "additionalProperties": false, "required": ["id", "name", "scope_type"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "scope_type": {"type": "string"}}},
        "breadcrumbs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}}}},
        "nodes": {"type": "array", "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.api/common/v1#/$defs/viewNode"}},
        "edges": {"type": "array", "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.api/common/v1#/$defs/viewEdge"}},
        "scope_layout_revision": {"type": "integer", "minimum": 0}, "layout_set_revision": {"type": "integer", "minimum": 0}, "graph_revision": {"type": "integer", "minimum": 0},
        "total_direct_items": {"type": "integer", "minimum": 0}, "overflow_strategy": {"const": "deterministic_bucket"}, "view_buckets": {"type": "array", "items": {"type": "string"}}, "continuation_token": {"type": ["string", "null"]}
      }
    }
  },
  "examples": [{"code": 0, "data": {"current_scope": {"id": "scope:organization:root", "name": "Synthetic Organization", "scope_type": "organization"}, "breadcrumbs": [], "nodes": [], "edges": [], "scope_layout_revision": 0, "layout_set_revision": 0, "graph_revision": 1, "total_direct_items": 0, "overflow_strategy": "deterministic_bucket", "view_buckets": [], "continuation_token": null}}]
}
