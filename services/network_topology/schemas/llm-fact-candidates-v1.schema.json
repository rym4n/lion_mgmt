{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aioe.local/aioe.network-topology.llm-fact-candidates/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "devices", "device_groups", "network_contexts", "interfaces",
    "segments", "adjacencies", "routes", "routing_relationships", "tunnels", "memberships",
    "gateways", "security_boundaries", "wan_connections", "unresolved_references", "warnings"
  ],
  "properties": {
    "schema_version": {"const": "aioe.network-topology.llm-fact-candidates/v1"},
    "devices": {"type": "array", "items": {"$ref": "#/$defs/device"}},
    "device_groups": {"type": "array", "items": {"$ref": "#/$defs/deviceGroup"}},
    "network_contexts": {"type": "array", "items": {"$ref": "#/$defs/networkContext"}},
    "interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}},
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "adjacencies": {"type": "array", "items": {"$ref": "#/$defs/adjacency"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "routing_relationships": {"type": "array", "items": {"$ref": "#/$defs/routingRelationship"}},
    "tunnels": {"type": "array", "items": {"$ref": "#/$defs/tunnel"}},
    "memberships": {"type": "array", "items": {"$ref": "#/$defs/membership"}},
    "gateways": {"type": "array", "items": {"$ref": "#/$defs/gateway"}},
    "security_boundaries": {"type": "array", "items": {"$ref": "#/$defs/securityBoundary"}},
    "wan_connections": {"type": "array", "items": {"$ref": "#/$defs/wanConnection"}},
    "unresolved_references": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 512}}
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "candidate_ref": {"type": "string", "minLength": 1},
        "chassis_id": {"type": "string", "minLength": 1},
        "hostname": {"type": "string", "minLength": 1},
        "management_ip": {"type": "string", "minLength": 1},
        "interface": {"type": "string", "minLength": 1}
      }
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "device_type", "identity_aliases", "roles", "inventory_state", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "device_type": {"type": "string", "minLength": 1},
        "identity_aliases": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["type", "namespace", "value"],
            "properties": {"type": {"type": "string"}, "namespace": {"type": "string"}, "value": {"type": "string"}}
          }
        },
        "roles": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/stringSet"},
        "inventory_state": {"enum": ["managed", "discovered", "unknown"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "deviceGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "group_type", "identity", "member_selectors", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "group_type": {"enum": ["ha", "stack", "irf", "vss", "vsf", "mlag", "cluster"]},
        "identity": {"type": "string", "minLength": 1},
        "member_selectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selector"}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "networkContext": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "owning_candidate_ref", "kind", "local_id", "name", "namespace_attributes", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "owning_candidate_ref": {"type": "string", "minLength": 1},
        "kind": {"enum": ["vrf", "zone", "vlan", "network", "security", "wan"]},
        "local_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "namespace_attributes": {
          "type": "object", "additionalProperties": false,
          "properties": {"rd": {"type": "string"}, "route_targets": {"type": "array", "items": {"type": "string"}}, "vni": {"type": "integer"}, "vlan": {"type": "integer"}}
        },
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "device_candidate_ref", "context_candidate_ref", "canonical_name", "raw_name", "if_index", "mac", "parent_ref", "lag_ref", "addresses", "configured_state", "operational_state", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "device_candidate_ref": {"type": "string", "minLength": 1},
        "context_candidate_ref": {"type": ["string", "null"]}, "canonical_name": {"type": "string", "minLength": 1}, "raw_name": {"type": "string", "minLength": 1},
        "if_index": {"type": ["integer", "null"]}, "mac": {"type": ["string", "null"]}, "parent_ref": {"type": ["string", "null"]}, "lag_ref": {"type": ["string", "null"]},
        "addresses": {"type": "array", "items": {"type": "string"}}, "configured_state": {"type": "string"}, "operational_state": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "canonical_cidr", "device_candidate_ref", "context_candidate_ref", "vlan", "vni", "gateway_selectors", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "canonical_cidr": {"type": "string", "minLength": 1},
        "device_candidate_ref": {"type": ["string", "null"]}, "context_candidate_ref": {"type": ["string", "null"]},
        "vlan": {"type": ["integer", "null"]}, "vni": {"type": ["integer", "null"]},
        "gateway_selectors": {"type": "array", "items": {"$ref": "#/$defs/selector"}},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "adjacency": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "kind", "local_candidate_ref", "remote_selector", "attachments", "layer", "context_ref", "state", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["lldp", "cdp", "l3_neighbor"]},
        "local_candidate_ref": {"type": "string", "minLength": 1}, "remote_selector": {"$ref": "#/$defs/selector"},
        "attachments": {"type": "array", "items": {"type": "string"}}, "layer": {"enum": ["physical", "l2", "l3"]},
        "context_ref": {"type": ["string", "null"]}, "state": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "routingRelationship": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "protocol", "local_selector", "remote_selector", "vrf", "session_state", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "protocol": {"type": "string", "minLength": 1},
        "local_selector": {"$ref": "#/$defs/selector"}, "remote_selector": {"$ref": "#/$defs/selector"},
        "vrf": {"type": "string", "minLength": 1}, "session_state": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "route_type", "prefix", "vrf", "next_hop_selector", "interface_candidate_ref", "state", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "route_type": {"enum": ["connected", "static", "default", "dynamic"]},
        "prefix": {"type": "string", "minLength": 1}, "vrf": {"type": "string", "minLength": 1},
        "next_hop_selector": {"oneOf": [{"$ref": "#/$defs/selector"}, {"type": "null"}]},
        "interface_candidate_ref": {"type": ["string", "null"]}, "state": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "tunnel": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "tunnel_type", "tunnel_id", "context_ref", "local_endpoint", "remote_endpoint", "state", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "tunnel_type": {"type": "string", "minLength": 1}, "tunnel_id": {"type": "string", "minLength": 1},
        "context_ref": {"type": ["string", "null"]}, "local_endpoint": {"type": "string", "minLength": 1}, "remote_endpoint": {"type": "string", "minLength": 1}, "state": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "membership": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "member_candidate_ref", "container_candidate_ref", "membership_kind", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "member_candidate_ref": {"type": "string", "minLength": 1},
        "container_candidate_ref": {"type": "string", "minLength": 1}, "membership_kind": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "gateway": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "gateway_selector", "segment_candidate_ref", "gateway_kind", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "gateway_selector": {"$ref": "#/$defs/selector"},
        "segment_candidate_ref": {"type": "string", "minLength": 1}, "gateway_kind": {"enum": ["interface", "fhrp", "authoritative"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "securityBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "device_candidate_ref", "interface_candidate_ref", "zone_context_ref", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "device_candidate_ref": {"type": "string", "minLength": 1},
        "interface_candidate_ref": {"type": "string", "minLength": 1}, "zone_context_ref": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "wanConnection": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "connection_type", "local_selector", "remote_selector", "state", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "connection_type": {"enum": ["sdwan", "tunnel", "circuit"]},
        "local_selector": {"$ref": "#/$defs/selector"}, "remote_selector": {"$ref": "#/$defs/selector"}, "state": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "selector", "reason_code", "candidate_matches", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1}, "selector": {"$ref": "#/$defs/selector"},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "candidate_matches": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/evidenceRef"}}
      }
    }
  },
  "examples": [
    {
      "schema_version": "aioe.network-topology.llm-fact-candidates/v1",
      "devices": [], "device_groups": [], "network_contexts": [], "interfaces": [], "segments": [],
      "adjacencies": [], "routes": [], "routing_relationships": [], "tunnels": [], "memberships": [], "gateways": [],
      "security_boundaries": [], "wan_connections": [], "unresolved_references": [], "warnings": []
    }
  ]
}
