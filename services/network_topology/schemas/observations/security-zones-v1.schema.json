{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aioe.local/aioe.network-topology.observation/security.zones/v1",
  "x-max-bytes": 1048576,
  "x-allowed-source-methods": ["cli", "netconf", "restconf", "gnmi", "vendor_api"],
  "x-fact-planes": ["configured"],
  "allOf": [
    {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/observationBase"},
    {
      "properties": {
        "kind": {"const": "security.zones"},
        "source_method": {"enum": ["cli", "netconf", "restconf", "gnmi", "vendor_api"]},
        "content_type": {"const": "application/json"},
        "data_schema": {"const": "aioe.network-topology.observation/security.zones/v1"},
        "fact_plane": {"const": "configured"}
      },
      "if": {"properties": {"observation_status": {"const": "success"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["zones"],
            "properties": {
              "zones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["local_id", "name", "virtual_context"],
                  "properties": {
                    "local_id": {"type": "string", "minLength": 1},
                    "name": {"type": "string", "minLength": 1},
                    "virtual_context": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
