{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aioe.local/aioe.network-topology.observation/l3.vrfs/v1",
  "x-max-bytes": 2097152,
  "x-allowed-source-methods": ["cli", "netconf", "restconf", "gnmi", "vendor_api"],
  "x-fact-planes": ["configured"],
  "allOf": [
    {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/observationBase"},
    {
      "properties": {
        "kind": {"const": "l3.vrfs"},
        "source_method": {"enum": ["cli", "netconf", "restconf", "gnmi", "vendor_api"]},
        "content_type": {"const": "application/json"},
        "data_schema": {"const": "aioe.network-topology.observation/l3.vrfs/v1"},
        "fact_plane": {"const": "configured"}
      },
      "if": {"properties": {"observation_status": {"const": "success"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vrfs"],
            "properties": {
              "vrfs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["local_id", "name", "interfaces", "route_distinguishers", "route_targets"],
                  "properties": {
                    "local_id": {"type": "string", "minLength": 1},
                    "name": {"type": "string", "minLength": 1},
                    "virtual_context": {"type": ["string", "null"]},
                    "interfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                    "route_distinguishers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                    "route_targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                    "vni": {"type": ["integer", "null"], "minimum": 1}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
