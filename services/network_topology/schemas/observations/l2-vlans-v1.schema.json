{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aioe.local/aioe.network-topology.observation/l2.vlans/v1",
  "x-max-bytes": 2097152,
  "x-allowed-source-methods": ["cli", "netconf", "restconf", "gnmi", "snmp", "vendor_api"],
  "x-fact-planes": ["configured"],
  "allOf": [
    {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/observationBase"},
    {
      "properties": {
        "kind": {"const": "l2.vlans"},
        "source_method": {"enum": ["cli", "netconf", "restconf", "gnmi", "snmp", "vendor_api"]},
        "content_type": {"const": "application/json"},
        "data_schema": {"const": "aioe.network-topology.observation/l2.vlans/v1"},
        "fact_plane": {"const": "configured"}
      },
      "if": {"properties": {"observation_status": {"const": "success"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vlans"],
            "properties": {
              "vlans": {
                "type": "array",
                "maxItems": 8192,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["vlan_id", "name", "state"],
                  "properties": {
                    "vlan_id": {"type": "integer", "minimum": 1, "maximum": 16777215},
                    "name": {"type": "string"},
                    "state": {"enum": ["active", "suspended", "unknown"]},
                    "bridge_domain": {"type": ["string", "null"]},
                    "vni": {"type": ["integer", "null"], "minimum": 1}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
