{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aioe.local/aioe.network-topology.observation/overlay.vxlan_evpn/v1",
  "x-max-bytes": 4194304,
  "x-allowed-source-methods": ["cli", "netconf", "restconf", "gnmi", "vendor_api"],
  "x-fact-planes": ["configured", "operational"],
  "allOf": [
    {"$ref": "https://schemas.aioe.local/aioe.network-topology.common/v1#/$defs/observationBase"},
    {
      "properties": {
        "kind": {"const": "overlay.vxlan_evpn"},
        "source_method": {"enum": ["cli", "netconf", "restconf", "gnmi", "vendor_api"]},
        "content_type": {"const": "application/json"},
        "data_schema": {"const": "aioe.network-topology.observation/overlay.vxlan_evpn/v1"},
        "fact_plane": {"enum": ["configured", "operational"]}
      },
      "if": {"properties": {"observation_status": {"const": "success"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segments"],
            "properties": {
              "segments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["vtep", "vni", "vlan", "vrf", "rd", "route_targets", "peers", "state"],
                  "properties": {
                    "vtep": {"type": "string", "minLength": 1},
                    "vni": {"type": "integer", "minimum": 1},
                    "vlan": {"type": ["integer", "null"], "minimum": 1},
                    "vrf": {"type": ["string", "null"]},
                    "rd": {"type": ["string", "null"]},
                    "route_targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                    "peers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                    "state": {"enum": ["up", "down", "unknown"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
